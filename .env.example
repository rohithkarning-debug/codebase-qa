# Copy to .env and fill in ONE key. Free options: Gemini (aistudio.google.com) or Groq (console.groq.com).
# With no key at all the app runs in "offline mode" (answers assembled from search results).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: force a provider / model.
# Providers: gemini | groq | openai | anthropic | openrouter | ollama | offline
CQA_LLM_PROVIDER=
CQA_LLM_MODEL=

# Optional: a different (ideally stronger) model for LLM-as-Judge.
CQA_JUDGE_PROVIDER=
CQA_JUDGE_MODEL=

# Embedding models compared in the evaluation (downloaded from Hugging Face on first use).
CQA_CODE_EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
CQA_GENERAL_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Offline hashing embedder: no downloads, for tests / no internet only. Not for reported results.
# CQA_EMBED_BACKEND=hash
